    m_Metadata:
      m_Items: []
  - m_Id: 1147777144
    m_Localized: Search complete. Right-click to take or store, Ctrl+click to split.
      Use the side column for gear and hands. Press E or move away to close.
    m_Metadata:
      m_Items: []
  - m_Id: 1147777145
