      m_Items: []
  - m_Id: 1147777126
    m_Localized: Beans added. Enough for three cups.
    m_Metadata:
      m_Items: []
  - m_Id: 1147777127
    m_Localized: No beans available or there are still beans in the machine.
    m_Metadata:
      m_Items: []
  - m_Id: 1147777128
    m_Localized: 'Coffee collected: {0}. Still in the machine: {1}.'
    m_Metadata:
      m_Items: []
  - m_Id: 1147777129
    m_Localized: Your backpack and stash are full.
    m_Metadata:
      m_Items: []
  - m_Id: 1147777130
    m_Localized: 'Each raid brews one coffee using one water and one serving of beans.

      A
      batch of beans makes three cups. Refill supplies to keep brewing.'
    m_Metadata:
      m_Items: []
