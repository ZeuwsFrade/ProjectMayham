      m_Items: []
  - m_Id: 821654302783
    m_Localized: "\u0412 \u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043B\u044C\u043D\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302784
    m_Localized: "\u041F\u043E\u043A\u0430 \u043D\u0435 \u0437\u043D\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302785
    m_Localized: "\u0415\u0441\u043B\u0438 \u043D\u0435 \u0442\u0440\u0443\u0434\u043D\u043E\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302786
    m_Localized: "\u041F\u0440\u0430\u0432\u0434\u0430? \u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302787
    m_Localized: "\u041F\u0440\u0438\u043D\u0451\u0441? \u0422\u044B \u043B\u0443\u0447\u0448\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302788
    m_Localized: "\u041D\u0443? \u041A\u0430\u043A \u043F\u0440\u043E\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302789
    m_Localized: "\u0415\u0441\u0442\u044C \u043F\u0430\u0440\u0430 \u0434\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302790
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302791
    m_Localized: "\u0412\u0438\u0436\u0443, \u0432\u0441\u0451 \u043F\u0440\u0438
      \u0442\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302792
    m_Localized: "\u0414\u0432\u0435 \u043A\u0440\u0443\u0436\u043A\u0438, [\u0418\u0413\u0420\u041E\u041A]."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302793
    m_Localized: "\u0411\u0435\u0440\u0443\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302794
    m_Localized: "\u0411\u0435\u0440\u0443\u0441\u044C. \u0418 \u0435\u0449\u0451
      \u0432\u043E\u043F\u0440\u043E\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302795
    m_Localized: "\u0414\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302796
    m_Localized: "\u041D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302797
    m_Localized: "\u0412\u043E\u0442, \u0434\u0435\u0440\u0436\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302798
    m_Localized: "\u041F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302799
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302800
    m_Localized: "\u0414\u0430, \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302801
    m_Localized: "\u041D\u0435\u0442, \u0441\u0434\u0435\u043B\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302802
    m_Localized: "\u0415\u0441\u0442\u044C \u0434\u043B\u044F \u043C\u0435\u043D\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302803
    m_Localized: "\u0420\u0430\u0431\u043E\u0442\u044B \u043F\u043E\u043A\u0430 \u043D\u0435\u0442,
      [\u0418\u0413\u0420\u041E\u041A]. \u0417\u0430\u0433\u043B\u044F\u043D\u0438
      \u043F\u043E\u0437\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302804
    m_Localized: "\u0422\u044B \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0438\u0447\u0435\u0433\u043E
      \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302805
    m_Localized: "\u0422\u044B \u0435\u0449\u0451 \u043D\u0435 \u0432\u0441\u0451
      \u0441\u0434\u0435\u043B\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302806
    m_Localized: "\u0422\u0435\u0431\u0435 \u043D\u0435\u043A\u0443\u0434\u0430 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C
      \u043D\u0430\u0433\u0440\u0430\u0434\u0443. \u041E\u0441\u0432\u043E\u0431\u043E\u0434\u0438
      \u043C\u0435\u0441\u0442\u043E \u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302807
    m_Localized: "\u0411\u0440\u043E\u0441\u0430\u0435\u0448\u044C? \u041D\u0443
      \u0441\u043C\u043E\u0442\u0440\u0438, \u044F \u044D\u0442\u043E \u0437\u0430\u043F\u043E\u043C\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302808
    m_Localized: "\u041B\u0430\u0434\u043D\u043E. \u041D\u0430\u0439\u0434\u0443
      \u043A\u043E\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0434\u0440\u0443\u0433\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302809
    m_Localized: "\u041F\u043E \u043F\u043E\u0432\u043E\u0434\u0443 \u0442\u0432\u043E\u0435\u0433\u043E
      \u0437\u0430\u0434\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302810
    m_Localized: "\u041D\u043E\u0432\u043E\u0435 \u0434\u0435\u043B\u043E: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302811
    m_Localized: "\u0421\u0434\u0430\u0442\u044C: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302812
    m_Localized: "\u041E\u0442\u043C\u0435\u0447\u0435\u043D\u043E: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302813
    m_Localized: "\u041D\u0430\u0433\u0440\u0430\u0434\u0430: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302814
    m_Localized: "\u043D\u0430\u0432\u044B\u043A \xAB{0}\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302815
    m_Localized: "\u0447\u0435\u0440\u0442\u0451\u0436 \xAB{0}\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302816
    m_Localized: "\u0422\u0440\u044F\u0441\u0442\u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 821654302817
    m_Localized: "\u042F \u0442\u0435\u0431\u044F \u043F\u043E\u0447\u0442\u0438
      \u043D\u0435 \u0437\u043D\u0430\u044E. \u041F\u043E\u043C\u043E\u0433\u0438
      \u043C\u043D\u0435 \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u2014 \u0442\u043E\u0433\u0434\u0430
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302818
    m_Localized: "\u041D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302819
    m_Localized: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u044F\u0436\u0435\u043B\u043E:
      \u044D\u0442\u043E \u0435\u0449\u0451 {0:0.#} \u043A\u0433. \u041E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0441\u044C
      \u043E\u0442 \u043B\u0438\u0448\u043D\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302820
    m_Localized: "\u041D\u0435\u043A\u0443\u0434\u0430 \u0432\u0437\u044F\u0442\u044C:
      \u043D\u0443\u0436\u043D\u043E \u043C\u0435\u0441\u0442\u043E {0}\xD7{1} \u0432
      \u0440\u044E\u043A\u0437\u0430\u043A\u0435 \u0438\u043B\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435
      \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302821
    m_Localized: "\u0422\u0441-\u0441! \u041D\u0435 \u0448\u0443\u043C\u0438\u2026
      \u0422\u044B \u0436\u0438\u0432\u043E\u0439? \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439?\n\n\u042F
      \u0412\u0438\u0442\u044F, \u0441\u0442\u0430\u0436\u0451\u0440 \u0438\u0437
      \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u0438. \u041F\u043E\u0448\u0451\u043B
      \u0441\u0434\u0430\u0432\u0430\u0442\u044C \u043E\u0442\u0447\u0451\u0442 \u2014
      \u0438 \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0441\u044F. \u0414\u0430\u0432\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302822
    m_Localized: "\u0422\u0443\u0442 \u043A\u0442\u043E-\u0442\u043E \u0445\u043E\u0434\u0438\u0442.
      \u0423 \u043F\u0430\u0440\u043A\u043E\u0432\u043A\u0438. \u042F \u0432\u0438\u0434\u0435\u043B
      \u2014 \u044D\u0442\u043E \u043D\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A.\n\n\u042F
      \u0431\u0435\u0436\u0430\u043B \u0442\u0430\u043A, \u0447\u0442\u043E \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043B
      \u0432\u0441\u0435 \u0437\u0430\u043F\u0438\u0441\u0438. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0441\u0438\u0436\u0443 \u0438 \u043D\u0435 \u0434\u044B\u0448\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302823
    m_Localized: "\u0423\u0445\u043E\u0434\u0438\u043C?.. \u041D\u0435 \u043C\u043E\u0433\u0443.
      \u042F \u0442\u0430\u043A \u043E\u0441\u043B\u0430\u0431, \u0447\u0442\u043E
      \u0438 \u0448\u0430\u0433\u0443 \u043D\u0435 \u0441\u0434\u0435\u043B\u0430\u044E.
      \u041F\u043E\u043C\u043E\u0433\u0438 \u043C\u043D\u0435 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043F\u0440\u0438\u0439\u0442\u0438 \u0432 \u0441\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302824
    m_Localized: "\u041D\u0435 \u0437\u043D\u0430\u044E. \u0412\u044B\u0441\u043E\u043A\u043E\u0435.
      \u0421\u0442\u043E\u0438\u0442 \u0438 \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F,
      \u043F\u043E\u043A\u0430 \u043D\u0430 \u043D\u0435\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C.\n\n\u041F\u043E\u043C\u043E\u0433\u0438
      \u043C\u043D\u0435 \u043F\u0440\u0438\u0439\u0442\u0438 \u0432 \u0441\u0435\u0431\u044F
      \u2014 \u0430 \u0442\u0430\u043C \u0432\u0438\u0434\u043D\u043E \u0431\u0443\u0434\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302825
    m_Localized: "\u0422\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F!
      \u042F \u0443\u0436 \u0434\u0443\u043C\u0430\u043B, \u0442\u0435\u0431\u044F
      \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0441\u044A\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302826
    m_Localized: "\u0422\u0443\u0442 \u0445\u043E\u0442\u044F \u0431\u044B \u0435\u0441\u0442\u044C
      \u0441\u0442\u0443\u043B\u044C\u044F. \u0418 \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0445\u043E\u0434\u0438\u0442 \u0437\u0430 \u0441\u0442\u0435\u043D\u043E\u0439.\n\n\u0415\u0441\u043B\u0438
      \u0447\u0442\u043E-\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u2014 \u0443
      \u043C\u0435\u043D\u044F \u0437\u0430\u0432\u0430\u043B\u044F\u043B\u043E\u0441\u044C
      \u043A\u043E\u0435-\u0447\u0442\u043E \u0438\u0437 \u043A\u0430\u043D\u0446\u0435\u043B\u044F\u0440\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302827
    m_Localized: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u043E. \u0418\u043D\u043E\u0433\u0434\u0430
      \u043C\u043D\u0435 \u0441\u043D\u0438\u0442\u0441\u044F \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442.\n\n\u0413\u043E\u0432\u043E\u0440\u044F\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0448\u044C
      \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E, \u044F \u0441\u043C\u043E\u0433\u0443
      \u043A\u043E\u0435-\u0447\u0442\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C.
      \u042F \u0432\u0435\u0434\u044C \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0442\u0447\u0451\u0442\u044B \u0443\u043C\u0435\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302828
    m_Localized: "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, [\u0418\u0413\u0420\u041E\u041A]!
      \u0421\u0432\u043E\u0438\u043C \u0443 \u043C\u0435\u043D\u044F \u0432\u0441\u0435\u0433\u0434\u0430
      \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043F\u043E\u043B\u0443\u0447\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302829
    m_Localized: "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, [\u0418\u0413\u0420\u041E\u041A].
      \u041F\u0440\u0438\u0441\u0430\u0436\u0438\u0432\u0430\u0439\u0441\u044F, \u0441\u043C\u043E\u0442\u0440\u0438,
      \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C.
      \u0427\u0442\u043E-\u0442\u043E \u043F\u0440\u043E\u0434\u0430\u0448\u044C
      \u2014 \u0437\u0430\u043F\u043B\u0430\u0447\u0443 \u0447\u0435\u0441\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302830
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0432 \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442\u0435
      \u043A\u0442\u043E-\u0442\u043E \u0441\u0438\u0434\u0438\u0442. \u0416\u0438\u0432\u043E\u0439.
      \u0421\u0442\u0430\u0436\u0451\u0440 \u0438\u0437 \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u0438,
      \u0435\u0441\u043B\u0438 \u0432\u0435\u0440\u0438\u0442\u044C \u0441\u043B\u0443\u0445\u0430\u043C.\n\n\u041D\u0435
      \u0437\u043D\u0430\u044E, \u043A\u0442\u043E \u0435\u0433\u043E \u0442\u0443\u0434\u0430
      \u0437\u0430\u0442\u0430\u0449\u0438\u043B, \u043D\u043E \u0441\u0430\u043C
      \u043E\u043D \u043E\u0442\u0442\u0443\u0434\u0430 \u0432\u0440\u044F\u0434
      \u043B\u0438 \u0432\u044B\u0431\u0435\u0440\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302831
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u044F \u043A\u0443\u0434\u0430 \u0441\u043E\u0431\u0440\u0430\u043B\u0441\u044F.
      \u041D\u0443, \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302832
    m_Localized: "\u0412\u0435\u0437\u0434\u0435 \u043E\u0434\u043D\u043E \u0438
      \u0442\u043E \u0436\u0435: \u043D\u0435 \u0448\u0443\u043C\u0438, \u043D\u0435
      \u0433\u0435\u0440\u043E\u0439\u0441\u0442\u0432\u0443\u0439 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438
      \u043F\u043E\u0434 \u043D\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302833
    m_Localized: "\u0413\u043E\u0442\u043E\u0432\u0438\u0442 \u043E\u0434\u0438\u043D
      \u043A\u043E\u0444\u0435 \u0437\u0430 \u0440\u0435\u0439\u0434: \u0442\u0440\u0430\u0442\u0438\u0442
      \u043E\u0434\u043D\u0443 \u0432\u043E\u0434\u0443 \u0438 \u043E\u0434\u043D\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
      \u0437\u0451\u0440\u0435\u043D. \u041F\u043E\u0440\u0446\u0438\u0438 \u0437\u0451\u0440\u0435\u043D
      \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043D\u0430 \u0442\u0440\u0438
      \u043A\u043E\u0444\u0435. \u0411\u0430\u043A \u0432\u043C\u0435\u0449\u0430\u0435\u0442
      \u0442\u0440\u0438 \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302834
    m_Localized: "\u041F\u0435\u0440\u0435\u043C\u0430\u043B\u044B\u0432\u0430\u0435\u0442
      \u043A\u043D\u0438\u0433\u0438 \u0432 \u0431\u0443\u043C\u0430\u0433\u0443:
      \u0441\u0442\u043E\u043F\u043A\u0430 \u043A\u043D\u0438\u0433 \u2014 \u043F\u044F\u0442\u044C
      \u043F\u0430\u0447\u0435\u043A \u0431\u0443\u043C\u0430\u0433\u0438. \u0417\u0430\u0433\u0440\u0443\u0437\u0438
      \u043A\u043D\u0438\u0433\u0438, \u0430 \u043A \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044E
      \u0438\u0437 \u0440\u0435\u0439\u0434\u0430 \u0431\u0443\u043C\u0430\u0433\u0430
      \u0433\u043E\u0442\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302835
    m_Localized: "\u0412\u044B\u0432\u0435\u0434\u0438 \u043C\u0435\u043D\u044F \u043E\u0442\u0441\u044E\u0434\u0430,
      \u0430? \u041E\u0434\u0438\u043D \u044F \u043D\u0435 \u0434\u043E\u0439\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302836
    m_Localized: "\u0421\u0442\u0435\u043D\u044B\u2026 \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0435
      \u0441\u0442\u0435\u043D\u044B. \u0421\u043F\u0430\u0441\u0438\u0431\u043E,
      [\u0418\u0413\u0420\u041E\u041A].\n\n\u0412\u043E\u0437\u044C\u043C\u0438 \u043C\u043E\u0439
      \u043F\u043E\u0440\u0442\u0444\u0435\u043B\u044C. \u041C\u043D\u0435 \u043E\u043D
      \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u0438 \u043A \u0447\u0435\u043C\u0443
      \u2014 \u043E\u0442\u0447\u0451\u0442 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u043F\u0440\u043E\u043F\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302837
    m_Localized: "\u041A\u0440\u0443\u0436\u043A\u0430. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430
      \u043A\u0440\u0443\u0436\u043A\u0430. \u0411\u0435\u0437 \u043A\u043E\u0444\u0435
      \u044F \u0442\u0443\u0442 \u0441\u043E\u0439\u0434\u0443 \u0441 \u0443\u043C\u0430
      \u2014 \u0430 \u043A\u043E\u0444\u0435 \u0442\u0443\u0442 \u043D\u0435\u0442,
      \u043D\u043E \u0445\u043E\u0442\u044C \u043F\u043E\u0434\u0435\u0440\u0436\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302838
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E\u2026 \u0414\u0430\u0436\u0435
      \u0431\u0435\u0437 \u043A\u043E\u0444\u0435 \u0443\u0436\u0435 \u043B\u0435\u0433\u0447\u0435.\n\n\u0421\u043B\u0443\u0448\u0430\u0439\u2026
      \u0430 \u0432\u044B\u0432\u0435\u0434\u0435\u0448\u044C \u043C\u0435\u043D\u044F
      \u043E\u0442\u0441\u044E\u0434\u0430? \u042F \u0442\u0435\u043F\u0435\u0440\u044C
      \u0445\u043E\u0442\u044C \u043D\u0430 \u043D\u043E\u0433\u0430\u0445 \u0441\u0442\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302839
    m_Localized: "\u042F \u0431\u0435\u0436\u0430\u043B \u0442\u0430\u043A, \u0447\u0442\u043E
      \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043B \u0432\u0441\u0435 \u0437\u0430\u043F\u0438\u0441\u0438.
      \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u0437\u0430\u043F\u0438\u0441\u043A\u0438
      \u2014 \u043F\u043E \u043D\u0438\u043C \u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E
      \u043E\u0442\u0447\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302840
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E. \u0422\u0435\u043F\u0435\u0440\u044C
      \u044F \u043F\u043E\u0447\u0442\u0438 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0439
      \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302841
    m_Localized: "\u0422\u044B \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B,
      \u0447\u0442\u043E \u044F \u0432\u0438\u0434\u0435\u043B \u0443 \u043F\u0430\u0440\u043A\u043E\u0432\u043A\u0438.
      \u0421\u0445\u043E\u0434\u0438 \u0442\u0443\u0434\u0430 \u2014 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u0438 \u0441\u0440\u0430\u0437\u0443
      \u043D\u0430\u0437\u0430\u0434. \u041C\u043D\u0435 \u043D\u0430\u0434\u043E
      \u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E \u043C\u043D\u0435 \u043D\u0435
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302842
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043E\u043D\u043E \u0442\u0430\u043C\u2026
      \u041C\u043D\u0435 \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C.
      \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0441\u0445\u043E\u0434\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302843
    m_Localized: "\u0425\u043E\u0447\u0443 \u043D\u0430\u0432\u0435\u0441\u0442\u0438
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0432 \u043D\u0430\u0448\u0435\u043C
      \u0443\u0431\u0435\u0436\u0438\u0449\u0435. \u041F\u0440\u0438\u043D\u0435\u0441\u0438
      \u0434\u0432\u0435 \u043F\u0430\u0447\u043A\u0438 \u043F\u0430\u043F\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302844
    m_Localized: "\u0412\u043E\u0442 \u0442\u0435\u043F\u0435\u0440\u044C \u0437\u0434\u0435\u0441\u044C
      \u043A\u0430\u043A \u0432 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u043C
      \u043E\u0444\u0438\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302845
    m_Localized: "\u041A\u0440\u0443\u0436\u043A\u0430 \u0435\u0441\u0442\u044C.
      \u0421\u0442\u0435\u043D\u044B \u0435\u0441\u0442\u044C. \u0410 \u043A\u043E\u0444\u0435
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u043D\u0435\u0442. \u0422\u0430\u043A
      \u0436\u0438\u0442\u044C \u043D\u0435\u043B\u044C\u0437\u044F.\n\n\u042F \u043D\u0430\u0431\u0440\u043E\u0441\u0430\u043B
      \u0447\u0435\u0440\u0442\u0451\u0436 \u043A\u043E\u0444\u0435\u043C\u0430\u0448\u0438\u043D\u044B.
      \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u0434\u0432\u0435 \u043A\u0440\u0443\u0436\u043A\u0438,
      \u0434\u0432\u0435 \u0431\u0443\u0442\u044B\u043B\u043A\u0438 \u0432\u043E\u0434\u044B
      \u0438 \u0442\u0440\u0438 \u043F\u0430\u0447\u043A\u0438 \u0431\u0443\u043C\u0430\u0433\u0438:
      \u043F\u0440\u043E\u0432\u0435\u0440\u044E \u043F\u043E\u0434\u0430\u0447\u0443
      \u0432\u043E\u0434\u044B \u0438 \u0434\u043E\u0440\u0438\u0441\u0443\u044E
      \u0441\u0445\u0435\u043C\u0443. \u0417\u0430 \u044D\u0442\u043E \u043E\u0442\u0434\u0430\u043C
      \u0447\u0435\u0440\u0442\u0451\u0436 \u0438 \u043F\u043E\u0440\u0446\u0438\u044E
      \u0437\u0451\u0440\u0435\u043D \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0435
      \u0442\u0440\u0438 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302846
    m_Localized: "\u0414\u0432\u0435 \u043A\u0440\u0443\u0436\u043A\u0438, \u0434\u0432\u0435
      \u0432\u043E\u0434\u044B \u0438 \u0442\u0440\u0438 \u043F\u0430\u0447\u043A\u0438
      \u0431\u0443\u043C\u0430\u0433\u0438. \u0427\u0435\u0440\u0442\u0451\u0436
      \u043F\u043E\u0447\u0442\u0438 \u0433\u043E\u0442\u043E\u0432. \u0417\u0451\u0440\u043D\u0430
      \u043F\u043E\u0442\u043E\u043C \u0438\u0449\u0438 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0430\u0445
      \u043E\u0442\u0434\u044B\u0445\u0430 \u0438 \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302847
    m_Localized: "\u0420\u0430\u0431\u043E\u0442\u0430\u0435\u0442! \u041D\u0443,
      \u043D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435 \u0442\u043E\u0447\u043D\u043E.
      \u0414\u0435\u0440\u0436\u0438 \u0447\u0435\u0440\u0442\u0451\u0436 \u0438
      \u0437\u0451\u0440\u043D\u0430.\n\n\u041F\u043E\u0441\u0442\u0440\u043E\u0439
      \u043A\u043E\u0444\u0435\u043C\u0430\u0448\u0438\u043D\u0443 \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435 \u0434\u043B\u044F \u043C\u043E\u0434\u0443\u043B\u044F.
      \u0417\u0430\u043B\u0435\u0439 \u0432\u043E\u0434\u0443 \u0438 \u0437\u0430\u0441\u044B\u043F\u044C
      \u043F\u043E\u0440\u0446\u0438\u044E \u0437\u0451\u0440\u0435\u043D: \u043E\u043D\u0430
      \u0434\u0430\u0441\u0442 \u0442\u0440\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F.
      \u0417\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0435\u0439\u0434
      \u043C\u0430\u0448\u0438\u043D\u0430 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442
      \u043E\u0434\u0438\u043D \u043A\u043E\u0444\u0435, \u0435\u0441\u043B\u0438
      \u0435\u0441\u0442\u044C \u0432\u043E\u0434\u0430 \u0438 \u0437\u0451\u0440\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302848
    m_Localized: "\u041D\u0430\u0447\u043D\u0451\u043C \u0441 \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E,
      [\u0418\u0413\u0420\u041E\u041A]. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u044B
      \u0431\u0443\u043C\u0430\u0433\u0438 \u2014 \u043E\u0431\u044B\u0447\u043D\u044B\u0435,
      \u043E\u0444\u0438\u0441\u043D\u044B\u0435. \u0412 \u0440\u0435\u0439\u0434\u0435
      \u0438\u0445 \u043F\u043E\u043B\u043D\u043E: \u043B\u0435\u0436\u0430\u0442
      \u043F\u043E \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430\u043C \u0438
      \u0443 \u043A\u043E\u043F\u0438\u0440\u043E\u0432.\n\n\u041F\u0440\u0438\u043D\u0435\u0441\u0438
      \u0442\u0440\u0438 \u043F\u0430\u0447\u043A\u0438, \u0438 \u044F \u0437\u0430\u043F\u043B\u0430\u0447\u0443.
      \u0414\u0430, \u0437\u0430 \u0431\u0443\u043C\u0430\u0433\u0443. \u041D\u0435
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302849
    m_Localized: "\u0411\u0443\u043C\u0430\u0433\u0438, [\u0418\u0413\u0420\u041E\u041A].
      \u0422\u0440\u0438 \u043F\u0430\u0447\u043A\u0438. \u0421\u0430\u043C\u0438
      \u043E\u043D\u0438 \u043D\u0435 \u043F\u0440\u0438\u0434\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302850
    m_Localized: "\u0412\u043E\u0442 \u044D\u0442\u043E \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E.
      \u0414\u0435\u0440\u0436\u0438, \u043A\u0430\u043A \u0434\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B\u0438\u0441\u044C.\n\n\u0417\u0430\u0433\u043B\u044F\u043D\u0438
      \u0435\u0449\u0451 \u2014 \u0435\u0441\u0442\u044C \u0434\u0435\u043B\u043E
      \u043F\u043E\u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302851
    m_Localized: "\u0412 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435 \u0431\u043E\u0441\u0441\u0430
      \u043B\u0435\u0436\u0438\u0442 \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u043F\u0430\u043F\u043A\u0430.
      \u0427\u0442\u043E \u0432 \u043D\u0435\u0439 \u2014 \u043D\u0435 \u0442\u0432\u043E\u0451
      \u0434\u0435\u043B\u043E, \u0434\u0430 \u0438 \u043D\u0435 \u043C\u043E\u0451,
      \u0435\u0441\u043B\u0438 \u0447\u0435\u0441\u0442\u043D\u043E.\n\n\u041D\u0430\u0439\u0434\u0438
      \u0435\u0451 \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0438. \u041A\u0430\u0431\u0438\u043D\u0435\u0442
      \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u0441\u0440\u0430\u0437\u0443:
      \u0442\u0430\u043C \u043F\u0430\u0445\u043D\u0435\u0442 \u0432\u043B\u0430\u0441\u0442\u044C\u044E
      \u0438 \u0434\u043E\u0440\u043E\u0433\u0438\u043C \u043A\u043E\u0444\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302852
    m_Localized: "\u041A\u0440\u0430\u0441\u043D\u0430\u044F \u043F\u0430\u043F\u043A\u0430
      \u0438\u0437 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430 \u0431\u043E\u0441\u0441\u0430.
      \u041E\u043D\u0430 \u0442\u0430\u043C \u043E\u0434\u043D\u0430 \u0442\u0430\u043A\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302853
    m_Localized: "\u041E\u043D\u0430. \u0414\u0430\u0436\u0435 \u043D\u0435 \u043F\u043E\u043C\u044F\u0442\u0430.
      \u0421 \u0442\u043E\u0431\u043E\u0439 \u043F\u0440\u0438\u044F\u0442\u043D\u043E
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C, [\u0418\u0413\u0420\u041E\u041A]."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302854
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u043D\u0430 \u043F\u0430\u0440\u043A\u043E\u0432\u043A\u0435
      \u043A\u0442\u043E-\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043C\u0430\u0448\u0438\u043D\u0443 \u0441 \u0432\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u043C
      \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0435\u043C. \u0422\u0440\u0435\u0442\u0438\u0439
      \u0433\u043E\u0434 \u043A\u0430\u043A.\n\n\u0421\u0445\u043E\u0434\u0438, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
      \u0441\u0432\u043E\u0438\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u0438 \u0432\u0435\u0440\u043D\u0438\u0441\u044C. \u0416\u0438\u0432\u044B\u043C,
      [\u0418\u0413\u0420\u041E\u041A]: \u043C\u0451\u0440\u0442\u0432\u044B\u0435
      \u043F\u043B\u043E\u0445\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302855
    m_Localized: "\u041F\u0430\u0440\u043A\u043E\u0432\u043A\u0430. \u0414\u043E\u0439\u0434\u0438,
      \u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0441\u044C \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302856
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u0441\u0442\u043E\u0438\u0442. \u041B\u0430\u0434\u043D\u043E. \u0414\u0435\u0440\u0436\u0438
      \u0437\u0430 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302857
    m_Localized: "\u0425\u043E\u043B\u043E\u0434\u0430\u0435\u0442. \u041F\u0440\u0438\u043D\u0435\u0441\u0438
      \u0434\u0432\u0435 \u0441\u0442\u043E\u043F\u043A\u0438 \u043A\u043D\u0438\u0433
      \u2014 \u0447\u0438\u0442\u0430\u0442\u044C \u0438\u0445 \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0431\u0443\u0434\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302858
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E \u0433\u043E\u0440\u044F\u0442.
      \u0422\u043E \u0435\u0441\u0442\u044C \u2014 \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0435
      \u043A\u043D\u0438\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302859
    m_Localized: "\u0411\u0443\u043C\u0430\u0433\u0438 \u043E\u043F\u044F\u0442\u044C
      \u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C. \u041F\u044F\u0442\u044C
      \u043F\u0430\u0447\u0435\u043A, [\u0418\u0413\u0420\u041E\u041A], \u2014 \u0438
      \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u044B \u0432
      \u0440\u0430\u0441\u0447\u0451\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302860
    m_Localized: "\u0417\u0430\u0433\u043B\u044F\u043D\u0438 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0432 \u0442\u0443\u0430\u043B\u0435\u0442 \u0432 \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442\u0435.
      \u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044C,
      \u0447\u0442\u043E \u0442\u0430\u043C \u0432\u0441\u0451 \u043A\u0430\u043A
      \u043E\u0431\u044B\u0447\u043D\u043E. \u0418 \u0432\u0435\u0440\u043D\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302861
    m_Localized: "\u0411\u0443\u043C\u0430\u0433\u0430 \u043D\u0443\u0436\u043D\u0430
      \u0432\u0441\u0435\u043C, \u0430 \u043A\u043D\u0438\u0433\u0438 \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0447\u0438\u0442\u0430\u0435\u0442. \u0412\u0438\u0434\u0435\u043B
      \u044F \u0432 \u043E\u0434\u043D\u043E\u0439 \u0442\u0438\u043F\u043E\u0433\u0440\u0430\u0444\u0438\u0438
      \u043F\u0440\u0435\u0441\u0441: \u043A\u043D\u0438\u0433\u0438 \u0442\u0443\u0434\u0430,
      \u0431\u0443\u043C\u0430\u0433\u0430 \u043E\u0442\u0442\u0443\u0434\u0430.\n\n\u041F\u0440\u0438\u043D\u0435\u0441\u0438
      \u0442\u0440\u0438 \u0441\u0442\u043E\u043F\u043A\u0438 \u043A\u043D\u0438\u0433
      \u2014 \u043D\u0430 \u043F\u0440\u043E\u0431\u0443. \u0410 \u044F \u043D\u0430\u0440\u0438\u0441\u0443\u044E,
      \u043A\u0430\u043A \u0442\u0430\u043A\u043E\u0439 \u0441\u043E\u0431\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302862
    m_Localized: "\u0422\u0440\u0438 \u0441\u0442\u043E\u043F\u043A\u0438 \u043A\u043D\u0438\u0433,
      [\u0418\u0413\u0420\u041E\u041A]. \u0411\u0435\u0437 \u043D\u0438\u0445 \u0438
      \u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C \u043D\u0435\u0447\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302863
    m_Localized: "\u0414\u0435\u0440\u0436\u0438 \u0447\u0435\u0440\u0442\u0451\u0436.
      \u0421\u043E\u0431\u0435\u0440\u0451\u0448\u044C \u0432 \u0443\u0431\u0435\u0436\u0438\u0449\u0435
      \u0438\u0437 \u043F\u0430\u043F\u043E\u043A, \u0448\u0432\u0430\u0431\u0440\u044B
      \u0438 \u043F\u0430\u0440\u044B \u043C\u043E\u043D\u0435\u0442. \u041A\u0430\u043A
      \u2014 \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u0431\u0435\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302864
    m_Localized: "\u0423 \u043C\u0435\u043D\u044F \u0431\u044C\u0451\u0442\u0441\u044F
      \u043F\u043E\u0441\u0443\u0434\u0430. \u041D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439
      \u043A\u0430\u043A. \u041F\u0440\u0438\u043D\u0435\u0441\u0438 \u0434\u0432\u0435
      \u043A\u0440\u0443\u0436\u043A\u0438 \u2014 \u043B\u044E\u0431\u044B\u0435,
      \u043B\u0438\u0448\u044C \u0431\u044B \u0446\u0435\u043B\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302865
    m_Localized: "\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u044B \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0430\u0445
      \u043E\u0442\u0434\u044B\u0445\u0430 \u0436\u0440\u0443\u0442 \u043C\u043E\u043D\u0435\u0442\u044B
      \u0438 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u043D\u0435 \u043E\u0442\u0434\u0430\u044E\u0442.
      \u041D\u043E \u0435\u0441\u0442\u044C \u0441\u043F\u043E\u0441\u043E\u0431
      \u0441 \u043D\u0438\u043C\u0438 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F.\n\n\u041F\u0440\u0438\u043D\u0435\u0441\u0438
      \u043C\u043D\u0435 \u043F\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442
      \u2014 \u043F\u043E\u043A\u0430\u0436\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302866
    m_Localized: "\u041F\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442, [\u0418\u0413\u0420\u041E\u041A].
      \u0422\u043E\u0433\u0434\u0430 \u0438 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302867
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438: \u0431\u044C\u0451\u0448\u044C
      \u0441\u0431\u043E\u043A\u0443, \u0432\u043E\u0442 \u0441\u044E\u0434\u0430,
      \u0438 \u0442\u0440\u044F\u0441\u0451\u0448\u044C. \u0422\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435\u0434\u043E\u043B\u0433\u043E \u0438 \u043D\u0435 \u043D\u0430
      \u0432\u0435\u0441\u044C \u044D\u0442\u0430\u0436 \u2014 \u0441\u0431\u0435\u0433\u0443\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302868
    m_Localized: "\u2022 \u0416\u0430\u0436\u0434\u0430 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442
      \u043B\u0435\u0447\u0435\u043D\u0438\u0435, \u0433\u043E\u043B\u043E\u0434
      \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C.\n\u2022
      \u041A\u0443\u043B\u0435\u0440: \u043F\u043E\u0434\u043E\u0439\u0434\u0438
      \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439 E \u2014 \u0443\u0442\u043E\u043B\u0438\u0448\u044C
      \u0436\u0430\u0436\u0434\u0443. \u0412\u043E\u0434\u0430 \u0431\u044B\u0441\u0442\u0440\u043E
      \u043F\u0440\u043E\u0441\u0438\u0442\u0441\u044F \u043D\u0430\u0440\u0443\u0436\u0443.\n\u2022
      \u041A\u043E\u0433\u0434\u0430 \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u0440\u0438\u0441\u043F\u0438\u0447\u0438\u0442,
      \u0442\u044B \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0448\u044C\u0441\u044F,
      \u0430 \u0432\u0440\u0430\u0433\u0438 \u0443\u0447\u0443\u044E\u0442 \u0437\u0430\u043F\u0430\u0445.
      \u0422\u0443\u0430\u043B\u0435\u0442: \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439
      E.\n\u2022 \u0414\u0430\u043B\u044C\u0448\u0435 \u0434\u043E\u0440\u043E\u0433\u0438
      \u043D\u0435\u0442 \u2014 \u043D\u043E \u0432 \u0441\u0442\u0435\u043D\u0435
      \u0441\u043F\u0440\u0430\u0432\u0430 \u0434\u044B\u0440\u0430. \u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439
      E \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0435\u0439, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u043B\u0435\u0437\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302869
    m_Localized: "\u0415\u0441\u043B\u0438 \u0442\u044B \u044D\u0442\u043E \u0447\u0438\u0442\u0430\u0435\u0448\u044C
      \u2014 \u0442\u044B \u043E\u0447\u043D\u0443\u043B\u0441\u044F. \u0417\u0434\u0430\u043D\u0438\u0435
      \u043A\u0438\u0448\u0438\u0442 \u0414\u043E\u0445\u043E\u0434\u044F\u0433\u0430\u043C\u0438,
      \u043D\u043E \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u043A\u0430 \u0442\u0438\u0445\u043E.\n\n\u2022
      WASD \u2014 \u0438\u0434\u0442\u0438, Shift \u2014 \u0431\u0435\u0436\u0430\u0442\u044C
      (\u0442\u0440\u0430\u0442\u0438\u0442 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C).\n\u2022
      E \u2014 \u043E\u0431\u044B\u0441\u043A\u0430\u0442\u044C \u043C\u0435\u0431\u0435\u043B\u044C
      \u0438\u043B\u0438 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u0432\u0435\u0449\u044C.
      I \u2014 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C.\n\u2022 \u0412
      \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435 \u043D\u0430\u0432\u0435\u0434\u0438
      \u043A\u0443\u0440\u0441\u043E\u0440 \u043D\u0430 \u0435\u0434\u0443 \u0438
      \u043D\u0430\u0436\u043C\u0438 F \u2014 \u0441\u044A\u0435\u0448\u044C. \u041F\u041A\u041C
      \u2014 \u0432\u0437\u044F\u0442\u044C \u0432\u0435\u0449\u044C \u0432 \u0440\u0443\u043A\u0438,
      \u0442\u043E\u0433\u0434\u0430 \u0437\u0430\u0436\u043C\u0438 \u041B\u041A\u041C.\n\n\u0422\u044B
      \u0440\u0430\u043D\u0435\u043D, \u0430 \u0433\u043E\u043B\u043E\u0434 \u0441\u044A\u0435\u0434\u0430\u0435\u0442
      \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C. \u041D\u0430\u0439\u0434\u0438
      \u0435\u0434\u0443 \u0438 \u0431\u0438\u043D\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 821654302870
    m_Localized: "\u0414\u043E\u0445\u043E\u0434\u044F\u0433\u0438 \u0441\u043B\u0430\u0431\u044B
      \u043F\u043E\u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0435, \u043D\u043E
      \u0437\u043E\u0432\u0443\u0442 \u0441\u0432\u043E\u0438\u0445.\n\n\u2022 \u0417\u0430\u0436\u043C\u0438
      Ctrl \u2014 \u043F\u0440\u0438\u0441\u044F\u0434\u0435\u0448\u044C: \u0448\u0430\u0433\u0438
      \u043D\u0435 \u0441\u043B\u044B\u0448\u043D\u044B, \u0438 \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C
      \u0442\u0435\u0431\u044F \u043C\u043E\u0433\u0443\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0431\u043B\u0438\u0437\u0438.\n\u2022 \u041E\u0431\u044B\u0447\u043D\u044B\u0435
      \u0448\u0430\u0433\u0438 \u0441\u043B\u044B\u0448\u043D\u043E \u0440\u044F\u0434\u043E\u043C,
      \u0431\u0435\u0433 \u2014 \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430.\n\u2022
      \u041D\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u0439\u0441\u044F \u0438\u043C
      \u043D\u0430 \u0433\u043B\u0430\u0437\u0430: \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043E\u043D\u0438 \u0432\u043F\u0435\u0440\u0451\u0434, \u0430 \u043D\u0435
      \u0437\u0430 \u0441\u043F\u0438\u043D\u0443.\n\u2022 \u041F\u043E\u0434\u043E\u0431\u0440\u0430\u043D\u043D\u0430\u044F
      \u0432\u0435\u0449\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u0430 \u0432
      \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435. \u0417\u0430\u0436\u043C\u0438
      G, \u043D\u0430\u0432\u0435\u0434\u0438 \u043A\u0443\u0440\u0441\u043E\u0440
      \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438 \u2014 \u043E\u043D\u0430
      \u0443\u043F\u0430\u0434\u0451\u0442 \u0441 \u0448\u0443\u043C\u043E\u043C,
      \u0438 \u0432\u0440\u0430\u0433\u0438 \u043F\u043E\u0439\u0434\u0443\u0442
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
