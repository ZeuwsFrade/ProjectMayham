      m_Items: []
  - m_Id: 2013100879874
    m_Localized: "{0}\n<size=22><color=#FFFFFF99>{1:0.##} \u043A\u0433, \u0432 \u043D\u0430\u043B\u0438\u0447\u0438\u0438
