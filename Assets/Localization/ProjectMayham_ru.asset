    m_Metadata:
      m_Items: []
  - m_Id: 1143582726
    m_Localized: "\u041C\u0443\u0437\u044B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582727
    m_Localized: "\u041E\u0431\u0449\u0430\u044F \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582728
    m_Localized: "\u042F\u0437\u044B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582729
    m_Localized: "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582730
    m_Localized: "\u042D\u0444\u0444\u0435\u043A\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582731
    m_Localized: "\u042D\u041A\u0420\u0410\u041D \u0418 \u042F\u0417\u042B\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582732
    m_Localized: "\u0412 \u0440\u0443\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582733
    m_Localized: "\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582734
    m_Localized: "\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u0441\u0442\u043E\u043F\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582735
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582736
    m_Localized: "\u0412\u042B\u0425\u041E\u0414 \u0412 \u0420\u0415\u0419\u0414"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582737
    m_Localized: "\u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582738
    m_Localized: "\u0414\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582739
    m_Localized: "\u041D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582740
    m_Localized: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582741
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582742
    m_Localized: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582743
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582744
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435?
      \u041E\u043D\u043E \u0437\u0430\u0439\u043C\u0451\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043C\u0438\u043D\u0443\u0442 \u0438 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F
      \u0432 \u0443\u0431\u0435\u0436\u0438\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582745
    m_Localized: "\u0423\u0431\u0435\u0436\u0438\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582746
    m_Localized: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582747
    m_Localized: "\u0420\u0435\u0439\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582748
    m_Localized: "\u041C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582749
    m_Localized: "\u0417\u0410\u0413\u0420\u0423\u0417\u041A\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582750
    m_Localized: "\u0412\u044B \u043F\u043E\u0433\u0438\u0431\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582751
    m_Localized: "\u0412\u0441\u0451, \u0447\u0442\u043E \u0431\u044B\u043B\u043E
      \u043F\u0440\u0438 \u0432\u0430\u0441, \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E.
      \u0412\u044B \u043E\u0447\u043D\u0443\u043B\u0438\u0441\u044C \u0432 \u0443\u0431\u0435\u0436\u0438\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582752
    m_Localized: "\u0412 \u0443\u0431\u0435\u0436\u0438\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582753
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0443\u0431\u0435\u0436\u0438\u0449\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582754
    m_Localized: "\u0412\u044B \u043F\u043E\u043A\u0438\u043D\u0435\u0442\u0435 \u0440\u0435\u0439\u0434.
      \u0412\u0441\u0451, \u0447\u0442\u043E \u0432 \u0440\u044E\u043A\u0437\u0430\u043A\u0435,
      \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u043F\u0440\u0438 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582755
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582756
    m_Localized: "\u041E\u0441\u0442\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582757
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0438\u0437 \u0440\u0435\u0439\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582758
    m_Localized: "\u042D\u0442\u0430\u043F 1 \u0438\u0437 3 \xB7 \u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582759
    m_Localized: "WASD \u2014 \u0438\u0434\u0442\u0438, Shift \u2014 \u0431\u0435\u0436\u0430\u0442\u044C,
      \u043C\u044B\u0448\u044C \u2014 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C.\n\u0412\u044B
      \u0440\u0430\u043D\u0435\u043D\u044B \u0438 \u0433\u043E\u043B\u043E\u0434\u043D\u044B:
      \u043E\u0431\u044B\u0449\u0438\u0442\u0435 \u043C\u0435\u0431\u0435\u043B\u044C
      (E) \u0438 \u043D\u0430\u0439\u0434\u0438\u0442\u0435 \u0435\u0434\u0443 \u0438
      \u0431\u0438\u043D\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582760
    m_Localized: "\u041E\u0431\u044B\u0449\u0438\u0442\u0435 \u0448\u043A\u0430\u0444\u044B
      \u0438 \u044F\u0449\u0438\u043A\u0438 (E): \u043D\u0430\u0439\u0434\u0438\u0442\u0435
      \u0435\u0434\u0443 \u0438 \u0431\u0438\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582761
    m_Localized: "\u041F\u043E\u0435\u0448\u044C\u0442\u0435: I \u2014 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C,
      \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430 \u0435\u0434\u0443
      \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 F"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582762
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u044F\u0436\u0438\u0442\u0435 \u0440\u0430\u043D\u044B
      \u0431\u0438\u043D\u0442\u0430\u043C\u0438 (\u0442\u0430\u043A \u0436\u0435,
      F)"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582763
    m_Localized: "\u042D\u0442\u0430\u043F 2 \u0438\u0437 3 \xB7 \u0412\u0440\u0430\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582764
    m_Localized: "\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u0414\u043E\u0445\u043E\u0434\u044F\u0433\u0438.
      \u0417\u0430\u0436\u043C\u0438\u0442\u0435 Ctrl, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u0438\u0441\u0435\u0441\u0442\u044C: \u0448\u0430\u0433\u0438
      \u043D\u0435 \u0441\u043B\u044B\u0448\u043D\u044B,\n\u0430 \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C
      \u0432\u0430\u0441 \u043C\u043E\u0436\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0431\u043B\u0438\u0437\u0438. \u041D\u0435 \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0435
      \u0438\u043C \u0432 \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582765
    m_Localized: "\u041F\u0440\u0438\u0441\u044F\u0434\u044C\u0442\u0435 (Ctrl) \u0438
      \u043F\u0440\u043E\u043A\u0440\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u0437\u0430
      \u0441\u043F\u0438\u043D\u043E\u0439 \u0414\u043E\u0445\u043E\u0434\u044F\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582766
    m_Localized: "\u041F\u043E\u0434\u0431\u0435\u0440\u0438\u0442\u0435 \u043A\u0440\u0443\u0436\u043A\u0443
      \u0441 \u043F\u043E\u043B\u0430 (E)"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582767
    m_Localized: "\u041E\u0442\u0432\u043B\u0435\u043A\u0438\u0442\u0435 \u0432\u0442\u043E\u0440\u043E\u0433\u043E:
      \u0437\u0430\u0436\u043C\u0438\u0442\u0435 G, \u043F\u0440\u0438\u0446\u0435\u043B\u044C\u0442\u0435\u0441\u044C
      \u0438 \u0431\u0440\u043E\u0441\u044C\u0442\u0435 \u043A\u0440\u0443\u0436\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582768
    m_Localized: "\u041F\u0440\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C
      \u043A \u0432\u044B\u0445\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582769
    m_Localized: "\u042D\u0442\u0430\u043F 3 \u0438\u0437 3 \xB7 \u041C\u0438\u0440
      \u0432\u043E\u043A\u0440\u0443\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582770
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
      \u0441\u0435\u0431\u044F \u0432 \u043F\u043E\u0440\u044F\u0434\u043E\u043A.
      \u041A\u0443\u043B\u0435\u0440 \u0443\u0442\u043E\u043B\u044F\u0435\u0442 \u0436\u0430\u0436\u0434\u0443,\n\u0442\u0443\u0430\u043B\u0435\u0442
      \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u043D\u0443\u0436\u0434\u0443 \u2014
      \u0438\u043D\u0430\u0447\u0435 \u0432\u044B \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u0435\u0441\u044C,
      \u0430 \u0432\u0440\u0430\u0433\u0438 \u0432\u0430\u0441 \u0443\u0447\u0443\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582771
    m_Localized: "\u041F\u043E\u043F\u0435\u0439\u0442\u0435 \u0438\u0437 \u043A\u0443\u043B\u0435\u0440\u0430
      (\u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 E)"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582772
    m_Localized: "\u0421\u0445\u043E\u0434\u0438\u0442\u0435 \u0432 \u0442\u0443\u0430\u043B\u0435\u0442
      (\u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 E)"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582773
    m_Localized: "\u041F\u0440\u043E\u043B\u0435\u0437\u044C\u0442\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0434\u044B\u0440\u0443 (\u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      E)"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582774
    m_Localized: "\u041F\u0435\u0440\u0435\u043B\u0435\u0437\u044C\u0442\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u0443 (\u041F\u0440\u043E\u0431\u0435\u043B)"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582775
    m_Localized: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u043A\u043B\u044E\u0447
      \u0432 \u044F\u0449\u0438\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582776
    m_Localized: "\u041E\u0442\u043E\u043F\u0440\u0438\u0442\u0435 \u0434\u0432\u0435\u0440\u044C
      \u0438 \u0432\u044B\u0439\u0434\u0438\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582777
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C! \u041D\u0430
      \u043F\u043E\u043B\u0443 \u043B\u0435\u0436\u0438\u0442 \u043A\u0440\u0443\u0436\u043A\u0430
      \u2014 \u043F\u043E\u0434\u0431\u0435\u0440\u0438\u0442\u0435 \u0435\u0451
      (E). \u0411\u0440\u043E\u0448\u0435\u043D\u043D\u0430\u044F \u0432\u0435\u0449\u044C
      \u0448\u0443\u043C\u0438\u0442, \u0438 \u0432\u0440\u0430\u0433\u0438 \u0438\u0434\u0443\u0442
      \u043D\u0430 \u0448\u0443\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582778
    m_Localized: "\u0412\u0442\u043E\u0440\u043E\u0439 \u0414\u043E\u0445\u043E\u0434\u044F\u0433\u0430
      \u0441\u0442\u0435\u0440\u0435\u0436\u0451\u0442 \u0432\u044B\u0445\u043E\u0434.
      \u041D\u0435 \u0432\u0441\u0442\u0430\u0432\u0430\u044F, \u0437\u0430\u0436\u043C\u0438\u0442\u0435
      G \u0438 \u0431\u0440\u043E\u0441\u044C\u0442\u0435 \u043A\u0440\u0443\u0436\u043A\u0443
      \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439 \u0443\u0433\u043E\u043B
      \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0438\u043C.\n\u041A\u043E\u0433\u0434\u0430
      \u043E\u043D \u043F\u043E\u0439\u0434\u0451\u0442 \u043D\u0430 \u0448\u0443\u043C,
      \u043A\u0440\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u043A \u0432\u044B\u0445\u043E\u0434\u0443
      \u043F\u043E\u043D\u0438\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582779
    m_Localized: "\u041F\u0440\u043E\u0445\u043E\u0434 \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0436\u0435\u043D
      \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u043E\u0439. \u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435
      \u043A \u043D\u0435\u0439 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u041F\u0440\u043E\u0431\u0435\u043B, \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u043B\u0435\u0437\u0442\u044C
      (\u043D\u0443\u0436\u043D\u0430 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C)."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582780
    m_Localized: "\u0414\u0432\u0435\u0440\u044C \u043D\u0430\u0440\u0443\u0436\u0443
      \u0437\u0430\u043F\u0435\u0440\u0442\u0430. \u041A\u043B\u044E\u0447 \u0433\u0434\u0435-\u0442\u043E
      \u0432 \u044F\u0449\u0438\u043A\u0430\u0445 \u2014 \u043E\u0431\u044B\u0449\u0438\u0442\u0435
      \u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582781
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0414\u0432\u0435\u0440\u044C
      \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443
      \u043E\u0442\u043A\u0440\u044B\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582782
    m_Localized: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582783
    m_Localized: "\u0414\u0430\u043B\u044C\u0448\u0435 \u2014 \u0443\u0431\u0435\u0436\u0438\u0449\u0435:
      \u0442\u0430\u043C \u043C\u043E\u0436\u043D\u043E \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C,
      \u043F\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u0438 \u0441\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0440\u0435\u0439\u0434. \u0412\u0441\u0451, \u0447\u0442\u043E \u043F\u0440\u0438
      \u0432\u0430\u0441, \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
      \u0441 \u0432\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582784
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E:
      \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0441\u044F
      \u0441 \u043D\u0430\u0447\u0430\u043B\u0430 \u044D\u0442\u0430\u043F\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1143582785
    m_Localized: "\u0415\u0449\u0451 \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582786
    m_Localized: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 1143582787
    m_Localized: "\u0412\u044B \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u043F\u0430\u0434\u0451\u0442\u0435
      \u0432 \u0443\u0431\u0435\u0436\u0438\u0449\u0435. \u0412\u0441\u0451, \u0447\u0442\u043E
      \u043F\u0440\u0438 \u0432\u0430\u0441, \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
      \u0441 \u0432\u0430\u043C\u0438."
