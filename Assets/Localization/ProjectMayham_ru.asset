    m_Metadata:
      m_Items: []
  - m_Id: 2013100879879
    m_Localized: "\u0413\u043E\u0442\u043E\u0432\u043E: {0} \xD7{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879880
    m_Localized: "\u0413\u043E\u0442\u043E\u0432\u043E: \u043D\u0438\u0447\u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879881
    m_Localized: "{0}\n{1}\n\u0423 \u0442\u0435\u0431\u044F: {2} \xD7{3} (\u0440\u044E\u043A\u0437\u0430\u043A
      \u0438 \u0441\u043A\u043B\u0430\u0434)"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879882
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879883
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u043E: {0} \xD7{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879884
    m_Localized: "\u041D\u0435\u0447\u0435\u0433\u043E \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C
      \u0438\u043B\u0438 \u043D\u0435\u0442 \u043C\u0435\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879885
    m_Localized: "\u0417\u0430\u0431\u0440\u0430\u043D\u043E: {0} \xD7{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879886
    m_Localized: ". \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u043D\u0435
      \u0432\u043B\u0435\u0437\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879887
    m_Localized: "\u041D\u0435\u043A\u0443\u0434\u0430 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C:
      \u0440\u044E\u043A\u0437\u0430\u043A \u0438 \u0441\u043A\u043B\u0430\u0434
      \u043F\u043E\u043B\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879888
    m_Localized: "{0}: {1}{2}. \u041F\u041A\u041C \u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
      \u0432 \u0441\u0435\u0442\u043A\u0443 \u2014 \u0441\u043D\u044F\u0442\u044C,
      \u0437\u0430 \u043E\u043A\u043D\u043E \u2014 \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879889
    m_Localized: "{0}: \u043F\u0443\u0441\u0442\u043E. \u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
      \u0441\u044E\u0434\u0430 \u0432\u0435\u0449\u044C \u0438\u043B\u0438 \u041F\u041A\u041C
      \u043F\u043E \u043D\u0435\u0439 \u0432 \u0441\u0435\u0442\u043A\u0435 \u2014
      \u043D\u0430\u0434\u0435\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879890
    m_Localized: ". F \u2014 {0} (3 \u0441)"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879891
    m_Localized: "{0}. \u041F\u041A\u041C \u2014 \u043D\u0430\u0434\u0435\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879892
    m_Localized: " (\u0441\u0435\u0442\u043A\u0430 {0}\xD7{1})"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879893
    m_Localized: "\u0412\u044B\u0434\u0435\u043B\u0435\u043D\u043E: {0} \u0448\u0442.,
      {1:0.##} \u043A\u0433. \u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
      \u0433\u0440\u0443\u043F\u043F\u0443, G \u0438\u043B\u0438 \u0432\u044B\u0445\u043E\u0434
      \u0437\u0430 \u043E\u043A\u043D\u043E \u2014 \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879894
    m_Localized: "{0} \u043D\u0435\u043B\u044C\u0437\u044F \u0432\u0437\u044F\u0442\u044C
      \u0432 \u0440\u0443\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879895
    m_Localized: "{0}: {1}\u2026 ({2:0.#} \u0441)"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879896
    m_Localized: "\u0421\u044E\u0434\u0430 \u043D\u0430\u0434\u0435\u0432\u0430\u0435\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u043E, \u0447\u0442\u043E \u043D\u043E\u0441\u044F\u0442:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879897
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u0435
      ({0} \u0448\u0442.)"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879898
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879899
    m_Localized: "\u0421\u044E\u0434\u0430 \u043A\u043B\u0430\u0434\u0451\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u0435\u0440\u0451\u0442\u0441\u044F
      \u0432 \u0440\u0443\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879900
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0432\u0437\u044F\u0442\u044C: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879901
    m_Localized: "\u0412\u044B\u0434\u0435\u043B\u0435\u043D\u043E \u0440\u0430\u043C\u043A\u043E\u0439:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879902
    m_Localized: "\u041E\u0442\u0434\u0435\u043B\u0438\u0442\u044C {0} \u0438\u0437
      {1} (\u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F {2}). \u041A\u043E\u043B\u0435\u0441\u043E
      \u043C\u044B\u0448\u0438 \u0438\u043B\u0438 +/\u2212 \u2014 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E,
      Enter \u2014 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879903
    m_Localized: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0441\u044E\u0434\u0430
      \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879904
    m_Localized: "\u041C\u044B\u0448\u044C \u2014 \u043F\u0435\u0440\u0435\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u0442\u044C,
      R \u2014 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C, Ctrl+\u043A\u043B\u0438\u043A
      \u2014 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C. \u041F\u041A\u041C
      \u0438\u043B\u0438 Shift+\u043A\u043B\u0438\u043A \u2014 \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u0420\u0443\u043A\u0438 \u0438
      \u043E\u0434\u0435\u0436\u0434\u0430 \u2014 \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u044C
      \u0432 \u0441\u043B\u043E\u0442 \u0438\u043B\u0438 \u0438\u0437 \u0441\u043B\u043E\u0442\u0430
      (\u0442\u044F\u0436\u0451\u043B\u043E\u0435 \u0431\u0435\u0440\u0451\u0442\u0441\u044F
      \u0432 \u043E\u0431\u0435 \u0440\u0443\u043A\u0438), \u0434\u0432\u043E\u0439\u043D\u043E\u0439
      \u043A\u043B\u0438\u043A \u2014 \u043D\u0430\u0434\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879905
    m_Localized: "\u041D\u0435 \u043D\u0430\u0434\u0435\u0442\u044C: \u0431\u0443\u0434\u0435\u0442
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u044F\u0436\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879906
    m_Localized: "{0}: \u043F\u0443\u0441\u0442\u043E. \u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
      \u0441\u044E\u0434\u0430 \u0442\u043E, \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E
      \u0434\u0435\u0440\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879907
    m_Localized: "{0}: \u043F\u0443\u0441\u0442\u043E. \u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
      \u0441\u044E\u0434\u0430 \u0432\u0435\u0449\u044C \u0438\u043B\u0438 \u0434\u0432\u043E\u0439\u043D\u043E\u0439
      \u043A\u043B\u0438\u043A \u043F\u043E \u043D\u0435\u0439 \u2014 \u043D\u0430\u0434\u0435\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879908
    m_Localized: "{0}: {1}{2}. \u041F\u041A\u041C \u0438\u043B\u0438 Shift+\u043A\u043B\u0438\u043A
      \u2014 \u0443\u0431\u0440\u0430\u0442\u044C \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
      \u2014 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u043A\u0443\u0434\u0430
      \u043D\u0443\u0436\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879909
    m_Localized: "\u041D\u0435 \u043F\u043E\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F:
      \u043D\u0435\u0442 \u043C\u0435\u0441\u0442\u0430 \u0438\u043B\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0442\u044F\u0436\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879910
    m_Localized: "\u0421\u044E\u0434\u0430 \u044D\u0442\u043E \u043D\u0435 \u0433\u043E\u0434\u0438\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879911
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0432\u0437\u044F\u0442\u044C \u0432 \u044D\u0442\u0443 \u0440\u0443\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879912
    m_Localized: "\u0421\u044E\u0434\u0430 \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C:
      \u043C\u0435\u0441\u0442\u043E \u0437\u0430\u043D\u044F\u0442\u043E \u0438\u043B\u0438
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u044F\u0436\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879913
    m_Localized: "\u041D\u0435 \u0432\u0437\u044F\u0442\u044C \u0432 \u0440\u0443\u043A\u0438:
      \u0442\u043E, \u0447\u0442\u043E \u0432 \u043D\u0438\u0445, \u043D\u0435\u043A\u0443\u0434\u0430
      \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879914
    m_Localized: "\u041D\u0435 \u0432\u0437\u044F\u0442\u044C \u0432 \u0440\u0443\u043A\u0438:
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u044F\u0436\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879915
    m_Localized: "\u0421\u044E\u0434\u0430 \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C:
      \u043C\u0435\u0441\u0442\u043E \u0437\u0430\u043D\u044F\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879916
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043E\u0434\u043D\u0430 \u0448\u0442\u0443\u043A\u0430
      \u2014 \u0434\u0435\u043B\u0438\u0442\u044C \u043D\u0435\u0447\u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879917
    m_Localized: "{0} \xD7{1}: \u0441\u043A\u043E\u043B\u044C\u043A\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879918
    m_Localized: "\u041F\u043E\u043C\u0435\u0441\u0442\u0438\u043B\u043E\u0441\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879919
    m_Localized: "\u041D\u0435 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C:
      \u043D\u0435\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0433\u043E
      \u043C\u0435\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879920
    m_Localized: "{0:0.#} / {1:0.#} \u043A\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879921
    m_Localized: "{0:0.#} \u043A\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879922
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879923
    m_Localized: ". \u0414\u0432\u043E\u0439\u043D\u043E\u0439 \u043A\u043B\u0438\u043A
      \u2014 \u043D\u0430\u0434\u0435\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879924
    m_Localized: '{0} $'
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879925
    m_Localized: "\u0417\u0430\u0431\u0443\u0434\u044C \u043F\u0440\u043E \u0437\u0430\u043F\u0438\u0441\u0438.
      \u0423\u0445\u043E\u0434\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879926
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0432\u0438\u0434\u0435\u043B
      \u0443 \u043F\u0430\u0440\u043A\u043E\u0432\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879927
    m_Localized: "\u041F\u043E \u043F\u043E\u0432\u043E\u0434\u0443 \u0442\u0432\u043E\u0435\u0439
      \u043F\u0440\u043E\u0441\u044C\u0431\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879928
    m_Localized: "\u0427\u0442\u043E \u043F\u043E\u0441\u043E\u0432\u0435\u0442\u0443\u0435\u0448\u044C
      \u043F\u0435\u0440\u0435\u0434 \u0440\u0435\u0439\u0434\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879929
    m_Localized: "\u041A\u0430\u043D\u0446\u0435\u043B\u044F\u0440\u0438\u044F! \u041F\u043E\u0447\u0442\u0438
      \u043D\u0435 \u043A\u0440\u0430\u0434\u0435\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879930
    m_Localized: "\u0422\u0443\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0440\u044E\u043A\u0437\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879931
    m_Localized: "\u041C\u0430\u043A\u0443\u043B\u0430\u0442\u0443\u0440\u043D\u044B\u0439
      \u043F\u0440\u0435\u0441\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879932
    m_Localized: "\u041F\u043E\u043A\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u043D\u0443\u0436\u043D\u043E. \u0421\u043F\u0430\u0441\u0438\u0431\u043E,
      \u0447\u0442\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u043B, [\u0418\u0413\u0420\u041E\u041A]."
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879933
    m_Localized: "\u042F \u043F\u043E\u0434\u043E\u0436\u0434\u0443. \u042F \u0442\u0443\u0442
      \u0443\u0436\u0435 \u043F\u0440\u0438\u0432\u044B\u043A \u0436\u0434\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879934
    m_Localized: "\u0422\u0435\u0431\u0435 \u043D\u0435\u043A\u0443\u0434\u0430 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C\u2026
      \u041E\u0441\u0432\u043E\u0431\u043E\u0434\u0438 \u043C\u0435\u0441\u0442\u043E,
      \u044F \u043D\u0435 \u0443\u0431\u0435\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879935
    m_Localized: "\u0414\u0432\u0435 \u0441\u0442\u043E\u043F\u043A\u0438 \u043A\u043D\u0438\u0433,
      [\u0418\u0413\u0420\u041E\u041A]."
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879936
    m_Localized: "\u041C\u0430\u043A\u0443\u043B\u0430\u0442\u0443\u0440\u0430 \u043D\u0430
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879937
    m_Localized: "\u041F\u044F\u0442\u044C \u043F\u0430\u0447\u0435\u043A \u0431\u0443\u043C\u0430\u0433\u0438.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879938
    m_Localized: "\u0412\u043E\u0442 \u0438 \u0441\u043B\u0430\u0432\u043D\u043E.
      \u0414\u043E \u0437\u0430\u0432\u0442\u0440\u0430 \u0445\u0432\u0430\u0442\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879939
    m_Localized: "\u0422\u0443\u0430\u043B\u0435\u0442. \u0417\u0430\u0433\u043B\u044F\u043D\u0438
      \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879940
    m_Localized: "\u041A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E? \u041D\u0443
      \u0438 \u0445\u043E\u0440\u043E\u0448\u043E. \u0414\u0435\u0440\u0436\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879941
    m_Localized: "\u0426\u0435\u043B\u044B\u0435. \u041E\u0442\u043B\u0438\u0447\u043D\u043E.
      \u0412\u043E\u0442 \u0442\u0432\u043E\u0438 \u0434\u0435\u043D\u044C\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879942
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0435\u0448\u044C\u0442\u0435
      \u0438 \u043F\u0435\u0440\u0435\u0432\u044F\u0436\u0438\u0442\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
