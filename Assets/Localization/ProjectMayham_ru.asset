  - m_Id: 2013096685579
    m_Localized: "\u041B\u0435\u0447\u044C \u0441\u043F\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013096685580
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0432 \u0440\u0435\u0439\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 2013096685581
    m_Localized: "\u0412\u044B \u043F\u043E\u043A\u0438\u043D\u0435\u0442\u0435 \u0443\u0431\u0435\u0436\u0438\u0449\u0435.
      \u0412\u0441\u0451, \u0447\u0442\u043E \u043B\u0435\u0436\u0438\u0442 \u0432
      \u0432\u0430\u0448\u0435\u043C \u0440\u044E\u043A\u0437\u0430\u043A\u0435,
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0441 \u0432\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2013096685582
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2013096685583
    m_Localized: "\u041F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043C\u043E\u0434\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013096685584
    m_Localized: "\u041C\u0435\u0441\u0442\u043E \u0437\u0430\u043D\u044F\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2013096685585
    m_Localized: "\u041D\u0435\u043B\u044C\u0437\u044F \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2013096685586
    m_Localized: "\u041D\u0435\u0442 \u0447\u0435\u0440\u0442\u0435\u0436\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2013096685587
    m_Localized: "\u0423\u0436\u0435 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879872
    m_Localized: "\u041D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2013100879873
    m_Localized: "\u0412\u044B \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u043B\u0438.
      \u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E."
