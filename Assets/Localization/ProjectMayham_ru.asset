      \u0440\u0443\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777159
    m_Localized: ". Ctrl+\u043A\u043B\u0438\u043A \u2014 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777160
    m_Localized: "{0}: \u043F\u0443\u0441\u0442\u043E. \u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
      \u0441\u044E\u0434\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u2014
      \u0432\u0437\u044F\u0442\u044C \u0432 \u044D\u0442\u0443 \u0440\u0443\u043A\u0443,
      \u043A\u043B\u0438\u043A \u2014 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0435\u0451 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0439, Q \u2014 \u0441\u043C\u0435\u043D\u0438\u0442\u044C
      \u0440\u0443\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777161
    m_Localized: "{0}: {1}{2}. \u041F\u041A\u041C \u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
      \u0432 \u0441\u0435\u0442\u043A\u0443 \u2014 \u0443\u0431\u0440\u0430\u0442\u044C,
      \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E \u0440\u0443\u043A\u0443
      \u2014 \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u0442\u044C, H \u2014
      \u0443\u0431\u0440\u0430\u0442\u044C \u0432\u0441\u0451, G \u2014 \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777162
    m_Localized: "{0}{1} \u2014 {2:0.##} \u043A\u0433 ({3:0.##} \u043A\u0433/\u0448\u0442),
