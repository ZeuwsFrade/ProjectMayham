    m_Metadata:
      m_Items: []
  - m_Id: 1147777114
    m_Localized: "\u041A\u043E\u0444\u0435\u043C\u0430\u0448\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777115
    m_Localized: "\u0414\u043E\u043B\u0438\u0442\u044C \u0432\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777116
    m_Localized: "\u0417\u0430\u0441\u044B\u043F\u0430\u0442\u044C \u0437\u0451\u0440\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777117
    m_Localized: "\u0417\u0430\u0431\u0440\u0430\u0442\u044C \u043A\u043E\u0444\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777118
    m_Localized: "\u0420\u0435\u0441\u0443\u0440\u0441\u044B \u0431\u0435\u0440\u0443\u0442\u0441\u044F
      \u0438\u0437 \u0440\u044E\u043A\u0437\u0430\u043A\u0430 \u0438 \u0441\u043E
      \u0441\u043A\u043B\u0430\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777119
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043A\u043E\u0444\u0435
      \u0431\u0443\u0434\u0435\u0442 \u0433\u043E\u0442\u043E\u0432 \u043F\u043E\u0441\u043B\u0435
      \u0440\u0435\u0439\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777120
    m_Localized: "\u041D\u0443\u0436\u043D\u0430 \u043D\u043E\u0432\u0430\u044F \u043F\u043E\u0440\u0446\u0438\u044F
      \u0437\u0451\u0440\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777121
    m_Localized: "\u0414\u043E\u043B\u0435\u0439 \u0432\u043E\u0434\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777122
    m_Localized: "\u0412\u043E\u0434\u0430: {0}/{1}\n\u0417\u0451\u0440\u043D\u0430:
      {2}/{3} \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0439\n\u0413\u043E\u0442\u043E\u0432\u044B\u0439
      \u043A\u043E\u0444\u0435: {4}\n{5}"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777123
    m_Localized: "\u0414\u043E\u043B\u0438\u0442\u044C \u0432\u043E\u0434\u0443 \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777124
    m_Localized: "\u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043E \u0432\u043E\u0434\u044B:
      {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777125
    m_Localized: "\u041D\u0435\u0442 \u0432\u043E\u0434\u044B \u0438\u043B\u0438
      \u0431\u0430\u043A \u043F\u043E\u043B\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777126
    m_Localized: "\u0417\u0451\u0440\u043D\u0430 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u044B:
      \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430 \u0442\u0440\u0438 \u043A\u043E\u0444\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777127
    m_Localized: "\u041D\u0435\u0442 \u0437\u0451\u0440\u0435\u043D \u0438\u043B\u0438
      \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0430\u044F \u043F\u043E\u0440\u0446\u0438\u044F
      \u0435\u0449\u0451 \u043D\u0435 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777128
    m_Localized: "\u0417\u0430\u0431\u0440\u0430\u043D\u043E \u043A\u043E\u0444\u0435:
      {0}. \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0432 \u043C\u0430\u0448\u0438\u043D\u0435:
      {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777129
    m_Localized: "\u0412 \u0440\u044E\u043A\u0437\u0430\u043A\u0435 \u0438 \u043D\u0430
      \u0441\u043A\u043B\u0430\u0434\u0435 \u043D\u0435\u0442 \u043C\u0435\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777130
    m_Localized: "1 \u0432\u043E\u0434\u0430 + 1 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
      \u0437\u0451\u0440\u0435\u043D \u2192 1 \u043A\u043E\u0444\u0435 \u0437\u0430
      \u0440\u0435\u0439\u0434.\n\u041F\u043E\u0440\u0446\u0438\u0438 \u0437\u0451\u0440\u0435\u043D
      \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043D\u0430 \u0442\u0440\u0438
      \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F.
      \u0411\u0435\u0437 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u043C\u0430\u0448\u0438\u043D\u0430
      \u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777131
    m_Localized: "\u041C\u0435\u0441\u0442\u043E \u043F\u043E\u0434 \u043C\u043E\u0434\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777132
    m_Localized: "\u041F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777133
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043D\u0443\u0436\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777134
    m_Localized: "\u041D\u0443\u0436\u043D\u043E: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777135
    m_Localized: "\u041D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777136
    m_Localized: "\u041F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u043E: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777137
    m_Localized: "\u0422\u044B \u043D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C
      \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0447\u0435\u0440\u0442\u0435\u0436\u0430.
      \u0427\u0435\u0440\u0442\u0435\u0436\u0438 \u0434\u0430\u044E\u0442 \u0437\u0430
      \u0437\u0430\u0434\u0430\u043D\u0438\u044F, \u0430 \u0438\u043D\u043E\u0433\u0434\u0430
      \u0438\u0445 \u043D\u0430\u0445\u043E\u0434\u044F\u0442 \u0432 \u0440\u0435\u0439\u0434\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777138
    m_Localized: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C:"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777139
    m_Localized: "\u041F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777140
    m_Localized: "\u041E\u0442\u0434\u0435\u043B\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777141
    m_Localized: "\u041E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777142
    m_Localized: "\u041E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u2026
      E \u0438\u043B\u0438 \u0448\u0430\u0433 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u2014 \u0437\u0430\u043A\u0440\u044B\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777143
    m_Localized: "\u0418\u0434\u0451\u0442 \u043E\u0431\u044B\u0441\u043A: \u0432\u0435\u0449\u0438
      \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u043F\u043E \u043E\u0434\u043D\u043E\u0439.
      \u041F\u041A\u041C \u2014 \u0437\u0430\u0431\u0440\u0430\u0442\u044C, Ctrl+\u043A\u043B\u0438\u043A
      \u2014 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C. E \u0438\u043B\u0438
      \u0448\u0430\u0433 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u2014
      \u0437\u0430\u043A\u0440\u044B\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777144
    m_Localized: "\u041E\u0431\u044B\u0441\u043A\u0430\u043D\u043E. \u041F\u041A\u041C
      \u2014 \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u0438\u043B\u0438 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C,
      Ctrl+\u043A\u043B\u0438\u043A \u2014 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C,
      \u0440\u0443\u043A\u0438 \u0438 \u043E\u0434\u0435\u0436\u0434\u0430 \u2014
      \u0432 \u043A\u043E\u043B\u043E\u043D\u043A\u0435. E \u0438\u043B\u0438 \u0448\u0430\u0433
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u2014 \u0437\u0430\u043A\u0440\u044B\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1147777145
    m_Localized: "\u041D\u0435\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0433\u043E
      \u043C\u0435\u0441\u0442\u0430 \u0434\u043B\u044F \u043D\u043E\u0432\u043E\u0439
      \u0441\u0442\u043E\u043F\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777146
    m_Localized: "\u0412 \u044D\u0442\u043E\u0439 \u0441\u0442\u043E\u043F\u043A\u0435
      \u043E\u0434\u0438\u043D \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u0434\u0435\u043B\u0438\u0442\u044C
      \u043D\u0435\u0447\u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777147
    m_Localized: "\u041D\u0435\u043A\u0443\u0434\u0430 \u0443\u0431\u0440\u0430\u0442\u044C
      \u0442\u043E, \u0447\u0442\u043E \u0432 \u0440\u0443\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777148
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C:
      \u043D\u0435\u0442 \u043C\u0435\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777149
    m_Localized: "\u0412\u0435\u0441 {0:0.#} / {1:0.#} \u043A\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777150
    m_Localized: "\u041C\u044B\u0448\u044C \u2014 \u043F\u0435\u0440\u0435\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u0442\u044C,
      R \u2014 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C, Shift+\u043A\u043B\u0438\u043A
      \u0438\u043B\u0438 \u0440\u0430\u043C\u043A\u0430 \u2014 \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E, Ctrl+\u043A\u043B\u0438\u043A
      \u2014 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C, \u041F\u041A\u041C
      \u2014 \u0432\u0437\u044F\u0442\u044C \u0432 \u0440\u0443\u043A\u0443 \u0438\u043B\u0438
      \u043D\u0430\u0434\u0435\u0442\u044C, Q \u2014 \u0441\u043C\u0435\u043D\u0438\u0442\u044C
      \u0440\u0443\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777151
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0430\u0434\u0435\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777152
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u0442\u044C \u0432 \u0434\u0440\u0443\u0433\u0443\u044E
      \u0440\u0443\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777153
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0432\u0437\u044F\u0442\u044C \u0432 \u043E\u0431\u0435 \u0440\u0443\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777154
    m_Localized: "\u0422\u044F\u043D\u0438\u0442\u0435 \u0440\u0430\u043C\u043A\u0443,
      \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777155
    m_Localized: ", \u0432 \u043E\u0431\u0435\u0438\u0445 \u0440\u0443\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777156
    m_Localized: " (\u0430\u043A\u0442\u0438\u0432\u043D\u0430\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 1147777157
    m_Localized: ". \u041F\u041A\u041C \u2014 \u0432\u0437\u044F\u0442\u044C \u0432
      \u043E\u0431\u0435 \u0440\u0443\u043A\u0438"
    m_Metadata:
      m_Items: []
