  title: "\u0420\u0430\u0437\u0432\u0435\u0434\u043A\u0430 \u043D\u0430 \u043F\u0430\u0440\u043A\u043E\u0432\u043A\u0435"
  offerText: "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u043D\u0430 \u043F\u0430\u0440\u043A\u043E\u0432\u043A\u0435
