  order: 1
  title: "\u0411\u0443\u043C\u0430\u0436\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430"
  offerText: "\u041D\u0430\u0447\u043D\u0451\u043C \u0441 \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E,
    [\u0418\u0413\u0420\u041E\u041A]. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u044B
    \u0431\u0443\u043C\u0430\u0433\u0438 \u2014 \u043E\u0431\u044B\u0447\u043D\u044B\u0435,
    \u043E\u0444\u0438\u0441\u043D\u044B\u0435. \u0412 \u0440\u0435\u0439\u0434\u0435
    \u0438\u0445 \u043F\u043E\u043B\u043D\u043E: \u043B\u0435\u0436\u0430\u0442 \u043F\u043E
    \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430\u043C \u0438 \u0443 \u043A\u043E\u043F\u0438\u0440\u043E\u0432.\n\n\u041F\u0440\u0438\u043D\u0435\u0441\u0438
    \u0442\u0440\u0438 \u043F\u0430\u0447\u043A\u0438, \u0438 \u044F \u0437\u0430\u043F\u043B\u0430\u0447\u0443.
    \u0414\u0430, \u0437\u0430 \u0431\u0443\u043C\u0430\u0433\u0443. \u041D\u0435
    \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439."
  objectives:
  - kind: 0
    item: {fileID: 11400000, guid: 4ceb3b894e212c542a9dd3f4a336a78e, type: 2}
    count: 3
    room: 0
    text: 
  reminderText: "\u0411\u0443\u043C\u0430\u0433\u0438, [\u0418\u0413\u0420\u041E\u041A].
    \u0422\u0440\u0438 \u043F\u0430\u0447\u043A\u0438. \u0421\u0430\u043C\u0438 \u043E\u043D\u0438
    \u043D\u0435 \u043F\u0440\u0438\u0434\u0443\u0442."
  completedText: "\u0412\u043E\u0442 \u044D\u0442\u043E \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E.
    \u0414\u0435\u0440\u0436\u0438, \u043A\u0430\u043A \u0434\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B\u0438\u0441\u044C.\n\n\u0417\u0430\u0433\u043B\u044F\u043D\u0438
    \u0435\u0449\u0451 \u2014 \u0435\u0441\u0442\u044C \u0434\u0435\u043B\u043E \u043F\u043E\u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0435\u0435."
