  title: "\u041F\u0440\u0435\u0441\u0441 \u0434\u043B\u044F \u043C\u0430\u043A\u0443\u043B\u0430\u0442\u0443\u0440\u044B"
  offerText: "\u0411\u0443\u043C\u0430\u0433\u0430 \u043D\u0443\u0436\u043D\u0430
    \u0432\u0441\u0435\u043C, \u0430 \u043A\u043D\u0438\u0433\u0438 \u043D\u0438\u043A\u0442\u043E
    \u043D\u0435 \u0447\u0438\u0442\u0430\u0435\u0442. \u0412\u0438\u0434\u0435\u043B
    \u044F \u0432 \u043E\u0434\u043D\u043E\u0439 \u0442\u0438\u043F\u043E\u0433\u0440\u0430\u0444\u0438\u0438
    \u043F\u0440\u0435\u0441\u0441: \u043A\u043D\u0438\u0433\u0438 \u0442\u0443\u0434\u0430,
    \u0431\u0443\u043C\u0430\u0433\u0430 \u043E\u0442\u0442\u0443\u0434\u0430.\n\n\u041F\u0440\u0438\u043D\u0435\u0441\u0438
    \u0442\u0440\u0438 \u0441\u0442\u043E\u043F\u043A\u0438 \u043A\u043D\u0438\u0433
    \u2014 \u043D\u0430 \u043F\u0440\u043E\u0431\u0443. \u0410 \u044F \u043D\u0430\u0440\u0438\u0441\u0443\u044E,
    \u043A\u0430\u043A \u0442\u0430\u043A\u043E\u0439 \u0441\u043E\u0431\u0440\u0430\u0442\u044C."
  objectives:
  - kind: 0
    item: {fileID: 11400000, guid: cf2bc34d7d360854d9f82e921e6f4c17, type: 2}
    count: 3
    room: 0
    hidden: 0
    text: 
  reminderText: "\u0422\u0440\u0438 \u0441\u0442\u043E\u043F\u043A\u0438 \u043A\u043D\u0438\u0433,
    [\u0418\u0413\u0420\u041E\u041A]. \u0411\u0435\u0437 \u043D\u0438\u0445 \u0438
    \u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C \u043D\u0435\u0447\u0435\u0433\u043E."
  completedText: "\u0414\u0435\u0440\u0436\u0438 \u0447\u0435\u0440\u0442\u0451\u0436.
    \u0421\u043E\u0431\u0435\u0440\u0451\u0448\u044C \u0432 \u0443\u0431\u0435\u0436\u0438\u0449\u0435
    \u0438\u0437 \u043F\u0430\u043F\u043E\u043A, \u0448\u0432\u0430\u0431\u0440\u044B
    \u0438 \u043F\u0430\u0440\u044B \u043C\u043E\u043D\u0435\u0442. \u041A\u0430\u043A
    \u2014 \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439, \u043F\u0440\u043E\u0441\u0442\u043E
    \u0441\u043E\u0431\u0435\u0440\u0438."
