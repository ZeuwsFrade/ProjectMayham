  m_Name: Intern
  m_EditorClassIdentifier: Assembly-CSharp::ProjectMayham.Quests.QuestGiverDefinition
  askChoice: "\u0427\u0435\u043C \u0442\u0435\u0431\u0435 \u043F\u043E\u043C\u043E\u0447\u044C?"
  menuText: "\u0415\u0441\u043B\u0438 \u043D\u0435 \u0442\u0440\u0443\u0434\u043D\u043E\u2026"
  noWorkText: "\u041F\u043E\u043A\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
    \u043D\u0443\u0436\u043D\u043E. \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E
    \u0441\u043F\u0440\u043E\u0441\u0438\u043B, [\u0418\u0413\u0420\u041E\u041A]."
  acceptedText: "\u041F\u0440\u0430\u0432\u0434\u0430? \u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
  reminderText: "\u042F \u043F\u043E\u0434\u043E\u0436\u0434\u0443. \u042F \u0442\u0443\u0442
    \u0443\u0436\u0435 \u043F\u0440\u0438\u0432\u044B\u043A \u0436\u0434\u0430\u0442\u044C."
  readyText: "\u041F\u0440\u0438\u043D\u0451\u0441? \u0422\u044B \u043B\u0443\u0447\u0448\u0438\u0439."
  noRoomText: "\u0422\u0435\u0431\u0435 \u043D\u0435\u043A\u0443\u0434\u0430 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C\u2026
    \u041E\u0441\u0432\u043E\u0431\u043E\u0434\u0438 \u043C\u0435\u0441\u0442\u043E,
    \u044F \u043D\u0435 \u0443\u0431\u0435\u0433\u0443."
  takenChoice: "\u041F\u043E \u043F\u043E\u0432\u043E\u0434\u0443 \u0442\u0432\u043E\u0435\u0433\u043E
    \u0437\u0430\u0434\u0430\u043D\u0438\u044F"
  takenText: "\u041D\u0443? \u041A\u0430\u043A \u043F\u0440\u043E\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F?"
  noTakenText: "\u0422\u044B \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0438\u0447\u0435\u0433\u043E
    \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0448\u044C."
  dailySlots: 2
  abandonAskText: "\u0411\u0440\u043E\u0441\u0430\u0435\u0448\u044C? \u041D\u0443
    \u0441\u043C\u043E\u0442\u0440\u0438, \u044F \u044D\u0442\u043E \u0437\u0430\u043F\u043E\u043C\u043D\u044E."
  abandonedText: "\u041B\u0430\u0434\u043D\u043E. \u041D\u0430\u0439\u0434\u0443
    \u043A\u043E\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0434\u0440\u0443\u0433\u043E\u0433\u043E."
