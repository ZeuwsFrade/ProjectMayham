--- !u!114 &1566752165
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1566752163}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 608fd8b22555ae5468c1fb4d458489fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProjectMayham.Tutorial.TutorialSign
  title: "\u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435"
  text: "\u0414\u043E\u0445\u043E\u0434\u044F\u0433\u0438 \u0441\u043B\u0430\u0431\u044B
    \u043F\u043E\u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0435, \u043D\u043E \u0437\u043E\u0432\u0443\u0442
    \u0441\u0432\u043E\u0438\u0445.\n\n\u2022 \u0417\u0430\u0436\u043C\u0438 Ctrl
    \u2014 \u043F\u0440\u0438\u0441\u044F\u0434\u0435\u0448\u044C: \u0448\u0430\u0433\u0438
    \u043D\u0435 \u0441\u043B\u044B\u0448\u043D\u044B, \u0438 \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C
    \u0442\u0435\u0431\u044F \u043C\u043E\u0433\u0443\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432\u0431\u043B\u0438\u0437\u0438.\n\u2022 \u041E\u0431\u044B\u0447\u043D\u044B\u0435
    \u0448\u0430\u0433\u0438 \u0441\u043B\u044B\u0448\u043D\u043E \u0440\u044F\u0434\u043E\u043C,
    \u0431\u0435\u0433 \u2014 \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430.\n\u2022
    \u041D\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u0439\u0441\u044F \u0438\u043C
    \u043D\u0430 \u0433\u043B\u0430\u0437\u0430: \u0441\u043C\u043E\u0442\u0440\u044F\u0442
    \u043E\u043D\u0438 \u0432\u043F\u0435\u0440\u0451\u0434, \u0430 \u043D\u0435
    \u0437\u0430 \u0441\u043F\u0438\u043D\u0443.\n\u2022 \u041F\u043E\u0434\u043E\u0431\u0440\u0430\u043D\u043D\u0430\u044F
    \u0432\u0435\u0449\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u0430 \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435.
    \u0417\u0430\u0436\u043C\u0438 G, \u043D\u0430\u0432\u0435\u0434\u0438 \u043A\u0443\u0440\u0441\u043E\u0440
    \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438 \u2014 \u043E\u043D\u0430 \u0443\u043F\u0430\u0434\u0451\u0442
    \u0441 \u0448\u0443\u043C\u043E\u043C, \u0438 \u0432\u0440\u0430\u0433\u0438
    \u043F\u043E\u0439\u0434\u0443\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C."
