--- !u!114 &190344261
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 190344259}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 608fd8b22555ae5468c1fb4d458489fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProjectMayham.Tutorial.TutorialSign
  title: "\u041F\u0430\u043C\u044F\u0442\u043A\u0430"
  text: "\u2022 \u0416\u0430\u0436\u0434\u0430 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442
    \u043B\u0435\u0447\u0435\u043D\u0438\u0435, \u0433\u043E\u043B\u043E\u0434 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442
    \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C.\n\u2022
    \u041A\u0443\u043B\u0435\u0440: \u043F\u043E\u0434\u043E\u0439\u0434\u0438 \u0438
    \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439 E \u2014 \u0443\u0442\u043E\u043B\u0438\u0448\u044C
    \u0436\u0430\u0436\u0434\u0443. \u0412\u043E\u0434\u0430 \u0431\u044B\u0441\u0442\u0440\u043E
    \u043F\u0440\u043E\u0441\u0438\u0442\u0441\u044F \u043D\u0430\u0440\u0443\u0436\u0443.\n\u2022
    \u041A\u043E\u0433\u0434\u0430 \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u0440\u0438\u0441\u043F\u0438\u0447\u0438\u0442,
    \u0442\u044B \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0448\u044C\u0441\u044F,
    \u0430 \u0432\u0440\u0430\u0433\u0438 \u0443\u0447\u0443\u044E\u0442 \u0437\u0430\u043F\u0430\u0445.
    \u0422\u0443\u0430\u043B\u0435\u0442: \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439
    E.\n\u2022 \u0414\u0430\u043B\u044C\u0448\u0435 \u0434\u043E\u0440\u043E\u0433\u0438
    \u043D\u0435\u0442 \u2014 \u043D\u043E \u0432 \u0441\u0442\u0435\u043D\u0435
    \u0441\u043F\u0440\u0430\u0432\u0430 \u0434\u044B\u0440\u0430. \u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439
    E \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0435\u0439, \u0447\u0442\u043E\u0431\u044B
    \u043F\u0440\u043E\u043B\u0435\u0437\u0442\u044C."
