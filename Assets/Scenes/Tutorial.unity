--- !u!114 &1460346826
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1460346824}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 608fd8b22555ae5468c1fb4d458489fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ProjectMayham.Tutorial.TutorialSign
  title: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430"
  text: "\u0415\u0441\u043B\u0438 \u0442\u044B \u044D\u0442\u043E \u0447\u0438\u0442\u0430\u0435\u0448\u044C
    \u2014 \u0442\u044B \u043E\u0447\u043D\u0443\u043B\u0441\u044F. \u0417\u0434\u0430\u043D\u0438\u0435
    \u043A\u0438\u0448\u0438\u0442 \u0414\u043E\u0445\u043E\u0434\u044F\u0433\u0430\u043C\u0438,
    \u043D\u043E \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u043A\u0430 \u0442\u0438\u0445\u043E.\n\n\u2022
    WASD \u2014 \u0438\u0434\u0442\u0438, Shift \u2014 \u0431\u0435\u0436\u0430\u0442\u044C
    (\u0442\u0440\u0430\u0442\u0438\u0442 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C).\n\u2022
    E \u2014 \u043E\u0431\u044B\u0441\u043A\u0430\u0442\u044C \u043C\u0435\u0431\u0435\u043B\u044C
    \u0438\u043B\u0438 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u0432\u0435\u0449\u044C.
    I \u2014 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C.\n\u2022 \u0412
    \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435 \u043D\u0430\u0432\u0435\u0434\u0438
    \u043A\u0443\u0440\u0441\u043E\u0440 \u043D\u0430 \u0435\u0434\u0443 \u0438 \u043D\u0430\u0436\u043C\u0438
    F \u2014 \u0441\u044A\u0435\u0448\u044C. \u041F\u041A\u041C \u2014 \u0432\u0437\u044F\u0442\u044C
    \u0432\u0435\u0449\u044C \u0432 \u0440\u0443\u043A\u0438, \u0442\u043E\u0433\u0434\u0430
    \u0437\u0430\u0436\u043C\u0438 \u041B\u041A\u041C.\n\n\u0422\u044B \u0440\u0430\u043D\u0435\u043D,
    \u0430 \u0433\u043E\u043B\u043E\u0434 \u0441\u044A\u0435\u0434\u0430\u0435\u0442
