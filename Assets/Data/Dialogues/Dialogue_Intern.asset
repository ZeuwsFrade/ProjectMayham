        choice: intern_saw
        amount: 0
  - id: go
    text: "\u0423\u0445\u043E\u0434\u0438\u043C?.. \u041D\u0435 \u043C\u043E\u0433\u0443.
      \u042F \u0442\u0430\u043A \u043E\u0441\u043B\u0430\u0431, \u0447\u0442\u043E
      \u0438 \u0448\u0430\u0433\u0443 \u043D\u0435 \u0441\u0434\u0435\u043B\u0430\u044E.
      \u041F\u043E\u043C\u043E\u0433\u0438 \u043C\u043D\u0435 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043F\u0440\u0438\u0439\u0442\u0438 \u0432 \u0441\u0435\u0431\u044F."
    start: 0
    conditions: []
    answers:
