  lines:
  - id: raid_first
    text: "\u0422\u0441-\u0441! \u041D\u0435 \u0448\u0443\u043C\u0438\u2026 \u0422\u044B
      \u0436\u0438\u0432\u043E\u0439? \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439?\n\n\u042F
      \u0412\u0438\u0442\u044F, \u0441\u0442\u0430\u0436\u0451\u0440 \u0438\u0437
      \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u0438. \u041F\u043E\u0448\u0451\u043B
      \u0441\u0434\u0430\u0432\u0430\u0442\u044C \u043E\u0442\u0447\u0451\u0442 \u2014
      \u0438 \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0441\u044F. \u0414\u0430\u0432\u043D\u043E."
    start: 1
    conditions:
    - kind: 5
      level: 1
      quest: {fileID: 0}
      stage: 0
      choice: 
      item: {fileID: 0}
      count: 0
    - kind: 3
