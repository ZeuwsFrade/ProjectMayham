      conditions: []
      actions:
      - kind: 0
        choice: intern_met
        amount: 0
  - id: hiding
    text: "\u0422\u0443\u0442 \u043A\u0442\u043E-\u0442\u043E \u0445\u043E\u0434\u0438\u0442.
      \u0423 \u043F\u0430\u0440\u043A\u043E\u0432\u043A\u0438. \u042F \u0432\u0438\u0434\u0435\u043B
      \u2014 \u044D\u0442\u043E \u043D\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A.\n\n\u042F
      \u0431\u0435\u0436\u0430\u043B \u0442\u0430\u043A, \u0447\u0442\u043E \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043B
      \u0432\u0441\u0435 \u0437\u0430\u043F\u0438\u0441\u0438. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0441\u0438\u0436\u0443 \u0438 \u043D\u0435 \u0434\u044B\u0448\u0443."
    start: 0
    conditions: []
    answers:
    - text: "\u0417\u0430\u0431\u0443\u0434\u044C \u043F\u0440\u043E \u0437\u0430\u043F\u0438\u0441\u0438.
        \u0423\u0445\u043E\u0434\u0438\u043C"
      next: go
      conditions: []
      actions:
      - kind: 0
        choice: intern_heard
        amount: 0
      - kind: 0
        choice: intern_fled
        amount: 0
    - text: "\u0427\u0442\u043E \u0442\u044B \u0432\u0438\u0434\u0435\u043B \u0443
        \u043F\u0430\u0440\u043A\u043E\u0432\u043A\u0438?"
      next: saw
      conditions: []
      actions:
      - kind: 0
        choice: intern_heard
        amount: 0
