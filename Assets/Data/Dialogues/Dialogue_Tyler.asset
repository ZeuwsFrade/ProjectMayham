  m_Script: {fileID: 11500000, guid: 4da0756e1daf6074887227546ac719e1, type: 3}
  m_Name: Dialogue_Tyler
  m_EditorClassIdentifier: Assembly-CSharp::ProjectMayham.Dialogue.DialogueDefinition
  lines:
  - id: start_friend
    text: "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, [\u0418\u0413\u0420\u041E\u041A]!
      \u0421\u0432\u043E\u0438\u043C \u0443 \u043C\u0435\u043D\u044F \u0432\u0441\u0435\u0433\u0434\u0430
      \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043F\u043E\u043B\u0443\u0447\u0448\u0435."
    start: 1
    conditions:
    - kind: 0
      level: 2
      quest: {fileID: 0}
      stage: 0
      choice: 
      item: {fileID: 0}
      count: 0
    answers:
    - text: "\u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C
        \u0442\u043E\u0432\u0430\u0440\u044B"
      next: start_friend
      conditions: []
      actions:
      - kind: 2
        choice: 
        amount: 0
    - text: "\u0415\u0441\u0442\u044C \u0434\u043B\u044F \u043C\u0435\u043D\u044F
        \u0440\u0430\u0431\u043E\u0442\u0430?"
      next: 
      conditions: []
      actions:
      - kind: 1
        choice: 
        amount: 0
    - text: "\u0427\u0442\u043E \u043D\u043E\u0432\u043E\u0433\u043E?"
      next: news
      conditions: []
      actions: []
    - text: "\u042F \u043F\u043E\u0439\u0434\u0443"
      next: 
      conditions: []
      actions: []
  - id: start
    text: "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, [\u0418\u0413\u0420\u041E\u041A].
      \u041F\u0440\u0438\u0441\u0430\u0436\u0438\u0432\u0430\u0439\u0441\u044F, \u0441\u043C\u043E\u0442\u0440\u0438,
      \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C.
      \u0427\u0442\u043E-\u0442\u043E \u043F\u0440\u043E\u0434\u0430\u0448\u044C
      \u2014 \u0437\u0430\u043F\u043B\u0430\u0447\u0443 \u0447\u0435\u0441\u0442\u043D\u043E."
    start: 1
    conditions: []
    answers:
    - text: "\u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C
        \u0442\u043E\u0432\u0430\u0440\u044B"
      next: start
      conditions: []
      actions:
      - kind: 2
        choice: 
        amount: 0
    - text: "\u0415\u0441\u0442\u044C \u0434\u043B\u044F \u043C\u0435\u043D\u044F
        \u0440\u0430\u0431\u043E\u0442\u0430?"
      next: 
      conditions: []
      actions:
      - kind: 1
        choice: 
        amount: 0
    - text: "\u042F \u043F\u043E\u0439\u0434\u0443"
      next: 
      conditions: []
      actions: []
  - id: news
    text: "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0432 \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442\u0435
      \u043A\u0442\u043E-\u0442\u043E \u0441\u0438\u0434\u0438\u0442. \u0416\u0438\u0432\u043E\u0439.
      \u0421\u0442\u0430\u0436\u0451\u0440 \u0438\u0437 \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u0438,
      \u0435\u0441\u043B\u0438 \u0432\u0435\u0440\u0438\u0442\u044C \u0441\u043B\u0443\u0445\u0430\u043C.\n\n\u041D\u0435
      \u0437\u043D\u0430\u044E, \u043A\u0442\u043E \u0435\u0433\u043E \u0442\u0443\u0434\u0430
      \u0437\u0430\u0442\u0430\u0449\u0438\u043B, \u043D\u043E \u0441\u0430\u043C
      \u043E\u043D \u043E\u0442\u0442\u0443\u0434\u0430 \u0432\u0440\u044F\u0434
      \u043B\u0438 \u0432\u044B\u0431\u0435\u0440\u0435\u0442\u0441\u044F."
    start: 0
    conditions: []
    answers:
    - text: "\u042F\u0441\u043D\u043E"
      next: start_friend
      conditions: []
      actions: []
